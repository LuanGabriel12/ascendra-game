{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ascendra.game/contracts/neon-carbon/contribution-result.v1.schema.json",
  "title": "ContributionResultWireV1",
  "description": "Cross-language JSON Schema (v1) matching NEON ports.ContributionResult. Supports opaque deterministic string IDs and canonical decimal strings for int64/uint64.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "simulation_id",
    "invasion_id",
    "settlement_id",
    "tick",
    "player_id",
    "damage",
    "support",
    "objectives",
    "eligible",
    "outcome"
  ],
  "properties": {
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "simulation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "invasion_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "settlement_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "tick": {
      "description": "Logical simulation tick (uint64 [0, 18446744073709551615]) as canonical decimal string or safe JSON integer.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18}|1([0-7][0-9]{18}|8([0-3][0-9]{17}|4([0-3][0-9]{16}|4([0-5][0-9]{15}|6([0-6][0-9]{14}|7([0-3][0-9]{13}|4([0-3][0-9]{12}|4(0([0-6][0-9]{10}|7([0-2][0-9]{9}|3([0-6][0-9]{8}|7(0([0-8][0-9]{6}|9([0-4][0-9]{5}|5([0-4][0-9]{4}|5(0[0-9]{3}|1([0-5][0-9]{2}|6(0[0-9]{1}|1[0-5])))))))))))))))))))$"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "player_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "damage": {
      "$ref": "#/$defs/nonNegativeInt64"
    },
    "support": {
      "$ref": "#/$defs/nonNegativeInt64"
    },
    "objectives": {
      "$ref": "#/$defs/nonNegativeInt64"
    },
    "eligible": {
      "type": "boolean"
    },
    "outcome": {
      "type": "string",
      "enum": ["Defended", "Captured"]
    }
  },
  "$defs": {
    "nonNegativeInt64": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9([0-1][0-9]{17}|2([0-1][0-9]{16}|2([0-2][0-9]{15}|3([0-2][0-9]{14}|3([0-6][0-9]{13}|7([0-1][0-9]{12}|2(0([0-2][0-9]{10}|3([0-5][0-9]{9}|6([0-7][0-9]{8}|8([0-4][0-9]{7}|5([0-3][0-9]{6}|4([0-6][0-9]{5}|7([0-6][0-9]{4}|7([0-4][0-9]{3}|5([0-7][0-9]{2}|8(0[0-7]))))))))))))))))))$"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    }
  }
}
