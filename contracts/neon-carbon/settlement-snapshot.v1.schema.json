{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ascendra.game/contracts/neon-carbon/settlement-snapshot.v1.schema.json",
  "title": "SettlementSnapshotWireV1",
  "description": "Cross-language JSON Schema (v1) for NEON SettlementReader.GetSettlementSnapshot backed by CARBON PostgreSQL projection. 64-bit max_defense_hp uses canonical decimal strings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "settlement_id",
    "region_id",
    "defense_state",
    "max_defense_hp"
  ],
  "properties": {
    "contract_version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "settlement_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "region_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S"
    },
    "defense_state": {
      "type": "string",
      "enum": ["Secure", "Fortified", "Damaged", "Captured"]
    },
    "max_defense_hp": {
      "description": "Positive int64 [1, 9223372036854775807] as canonical decimal string (or safe JSON integer <= 9007199254740991).",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9([0-1][0-9]{17}|2([0-1][0-9]{16}|2([0-2][0-9]{15}|3([0-2][0-9]{14}|3([0-6][0-9]{13}|7([0-1][0-9]{12}|2(0([0-2][0-9]{10}|3([0-5][0-9]{9}|6([0-7][0-9]{8}|8([0-4][0-9]{7}|5([0-3][0-9]{6}|4([0-6][0-9]{5}|7([0-6][0-9]{4}|7([0-4][0-9]{3}|5([0-7][0-9]{2}|8(0[0-7]))))))))))))))))))$"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      ]
    },
    "settlement_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
