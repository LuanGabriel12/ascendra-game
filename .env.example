# ASCENDRA Backend — Example Environment Configuration
# Copy to .env for local execution against a standalone/Docker PostgreSQL instance.
# NEVER commit real credentials or production .env files.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL connection string (example placeholder values only)
DATABASE_URL=postgresql://ascendra_app:replace_with_local_password@localhost:5432/ascendra_dev
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
