{
  "name": "ascendra-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ASCENDRA modular backend — CARBON persistence & domain bounded contexts",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 \"tests/**/*.test.ts\"",
    "migrate:up": "node --import tsx src/scripts/migrate.ts up",
    "migrate:down": "node --import tsx src/scripts/migrate.ts down",
    "migrate:down:all": "node --import tsx src/scripts/migrate.ts down:all",
    "migrate:status": "node --import tsx src/scripts/migrate.ts status",
    "demo:session02": "node --import tsx src/scripts/demo-session-02.ts",
    "demo:session03": "node --import tsx src/scripts/demo-session-03.ts",
    "demo:session04": "node --import tsx src/scripts/demo-session-04.ts",
    "demo:session05": "node --import tsx src/scripts/demo-session-05.ts",
    "demo:session06": "node --import tsx src/scripts/demo-session-06.ts",
    "demo:session07": "node --import tsx src/scripts/demo-session-07.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^19.0.0-beta.20",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@19.0.0-beta.20": true,
    "esbuild@0.28.2": true
  }
}
